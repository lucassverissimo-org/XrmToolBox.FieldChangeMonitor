<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>LucasVerissimo.XrmToolBox.FieldChangeMonitor</id>
    <version>1.0.0.0</version>
    <title>Field Change Monitor</title>
    <authors>Lucas Verissimo</authors>
    <owners>Lucas Verissimo</owners>
    <projectUrl>https://github.com/lucassverissimo-org/XrmToolBox.FieldChangeMonitor</projectUrl>
    <icon>images\field-change-monitor-128.png</icon>
    <iconUrl>https://raw.githubusercontent.com/lucassverissimo-org/XrmToolBox.FieldChangeMonitor/main/assets/field-change-monitor-128.png</iconUrl>
    <readme>README.md</readme>
    <license type="expression">MIT</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Monitor Dataverse table field changes with FetchXML filters, multiple active watches, condition builder, lookup/option selectors, and Windows alerts.</description>
    <summary>Monitor Dataverse field changes from XrmToolBox.</summary>
    <releaseNotes>1.0.0.0: Initial Tool Library-ready release.</releaseNotes>
    <copyright>Copyright (c) Lucas Verissimo 2026</copyright>
    <tags>XrmToolBox Dataverse Dynamics365 FetchXML Monitor FieldChange</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.8">
        <dependency id="XrmToolBox" version="1.2025.7.71" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\LucasVerissimo.XrmToolBox.FieldChangeMonitor.dll" target="lib\net48\Plugins" />
    <file src="assets\field-change-monitor-128.png" target="images" />
    <file src="README.md" target="" />
  </files>
</package>
