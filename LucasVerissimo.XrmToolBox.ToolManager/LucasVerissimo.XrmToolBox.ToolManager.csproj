<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LucasVerissimo.XrmToolBox.ToolManager</RootNamespace>
    <AssemblyName>LucasVerissimo.XrmToolBox.ToolManager</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="ApiKeyForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ApiKeyForm.Designer.cs">
      <DependentUpon>ApiKeyForm.cs</DependentUpon>
    </Compile>
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="PublishConfirmationForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="PublishConfirmationForm.Designer.cs">
      <DependentUpon>PublishConfirmationForm.cs</DependentUpon>
    </Compile>
    <Compile Update="ToolManagementForm.Designer.cs">
      <DependentUpon>ToolManagementForm.cs</DependentUpon>
    </Compile>
    <Compile Update="ToolManagementForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <EmbeddedResource Update="ApiKeyForm.resx">
      <DependentUpon>ApiKeyForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="PublishConfirmationForm.resx">
      <DependentUpon>PublishConfirmationForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="ToolManagementForm.resx">
      <DependentUpon>ToolManagementForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
</Project>
